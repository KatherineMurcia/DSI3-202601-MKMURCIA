# System files
.DS_Store
Thumbs.db

# Optional npm cache
.npm

# dotenv
.env
.env.test

# Build output
dist

# generated files
*.log
*.tmp
*.cache

# Yarn
.yarn-integrity

# Parcel
.cache
.parcel-cache

